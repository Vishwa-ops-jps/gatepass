# GatePass Cloud Environment Configuration

# 1. MongoDB Database Connection String
# Replace with your MongoDB Atlas or local MongoDB connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gatepass?retryWrites=true&w=majority
MONGODB_DB_NAME=gatepass

# 2. Server Port (Render sets this dynamically)
PORT=5001
